        "name": "partner_application_input_check",
        "type": "CHECK",
        "definition": "CHECK ((((length(btrim((company_name)::text)) >= 1) AND (length(btrim((company_name)::text)) <= 255)) AND ((country_code)::text ~ '^[A-Z]{2}$'::text) AND ((contact_email)::text = lower(btrim((contact_email)::text))) AND ((contact_email)::text ~ '^[^[:space:]@]+@[^[:space:]@]+\\.[^[:space:]@]+$'::text) AND ((business_type)::text = ANY ((ARRAY['manufacturer'::character varying, 'distributor'::character varying, 'service_provider'::character varying, 'other'::character varying])::text[])) AND ((source)::text = 'public'::text) AND (version > 0) AND ((submission_key_hash)::text ~ '^[a-f0-9]{64}$'::text) AND ((request_digest)::text ~ '^[a-f0-9]{64}$'::text) AND ((locale)::text = ANY ((ARRAY['pl'::character varying, 'en'::character varying, 'de'::character varying, 'fr'::character varying, 'uk'::character varying, 'es'::character varying, 'zh'::character varying])::text[])) AND ((privacy_notice_version)::text = 'LOCAL_FIXTURE_ONLY'::text) AND ((retention_policy_status)::text = 'LEGAL_REVIEW_REQUIRED'::text) AND (retention_due_at IS NULL)))",
        "isValidated": true
      },
